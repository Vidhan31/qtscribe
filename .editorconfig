root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C and C++ source and header files
[*.{cpp,h,hpp,cc,cxx}]
indent_size = 4

# QML files
[*.qml]
indent_size = 4

# CMake files
[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 4

# Configuration and data files
[*.{json,yaml,yml,ini,desktop}]
indent_size = 2

# Markdown documentation
[*.md]
indent_size = 2
trim_trailing_whitespace = false
